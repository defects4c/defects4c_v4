export CXX=clang++
export CC=clang

{%for env_item in env %}
	export {{env_item}}
{%endfor%}


cd {{repo_dir}}



{% if gittree_dir %}git --git-dir={{gittree_dir}}/.git --work-tree={{repo_dir}} checkout -f {{commit_after}}
{% else %}git -C {{repo_dir}} checkout -f {{commit_after}}
{% endif %}
{% if gittree_dir %}git --git-dir={{gittree_dir}}/.git --work-tree={{repo_dir}} checkout -f {{commit_after}} -- {{src_file}}
{% else %}git -C {{repo_dir}} checkout -f {{commit_after}} -- {{src_file}}
{% endif %}


test_log_dirname=$(dirname  {{test_log}} )
mkdir -p $test_log_dirname


bash  inplace_build.sh {{build_dir}} {{test_log}} || { echo "Command 1 failed"; exit 1; }


bash inplace_test.sh  {{build_dir}}  {{test_log}}




{% if gittree_dir %}git --git-dir={{gittree_dir}}/.git --work-tree={{repo_dir}} checkout -f {{commit_before}} -- {{src_file}}
{% else %}git -C {{repo_dir}} checkout -f {{commit_before}} -- {{src_file}}
{% endif %}


bash  inplace_rebuild.sh {{build_dir}} {{test_log| replace("_fix.log", "_buggy.log") }} || { echo "Command 2 failed"; exit 1; }

bash inplace_test.sh  {{build_dir}}   {{test_log| replace("_fix.log", "_buggy.log") }}





USERNAME="defects4c_user"
chown -R "$USERNAME:$USERNAME" ./ || true