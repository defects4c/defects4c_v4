build_dir=$1
test_log=$2




# The redis tcl test harness binds a Unix domain socket whose absolute path is
# [file normalize ./tests/tmp/server.<pid>.<n>/socket]. In the pool-slot layout
# the slot prefix (/out/<proj>/git_repo_dir_<40-char-sha>/__sN/...) already
# exceeds the sun_path 108-char limit, so the test server fails with
# "unix socket path too long". `file normalize` resolves symlinks, so point
# tests/tmp at a short directory under /tmp; the normalized socket path then
# becomes /tmp/rds_<pid>/server.../socket which is well under 108 chars.
rm -rf tests/tmp
short_tmp="/tmp/rds_$$"
rm -rf "$short_tmp"
mkdir -p "$short_tmp"
ln -sfn "$short_tmp" tests/tmp
./runtest --single   {{test_flags|join(" ") }} > $test_log 2>&1




get_status() {
	string=$(cat $test_log )
	
    if [[ $string == *"The following tests failed"* ]] || [[ $string == *"==ERROR"* ]] || [[ $string == *"FAILED"* ]] || [[ $string == *"AddressSanitizer:"* ]] || [[ $string == *"SIGSEGV, Segmentation fault"* ]] || [[ $string == *"Segmentation fault"* ]] || [[ $string == *"core dumped"* ]] || [[ $string == *"[exception]:"* ]] || [[ $string == *"\[err\]"* ]] ; then	    
    	echo "FAILED\n"
	else
	    echo "success\n"
	fi	
}


get_err_msg() {

	awk '/\[err\]/,/\[/' $test_log >  $1 

 	awk '/err/,/WARNING The following tests/'  $test_log >>  $1

}


fix_log="${test_log/\.log/}"
echo $fix_log"---->"

status_log=$( get_status)
echo $status_log > "${fix_log}.status"

get_err_msg  "${fix_log}.msg" 

