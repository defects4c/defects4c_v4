# bash inplace_test.sh [op_name] [argv]
# bash  inplace_test.sh "get_status" this_is_test_log 
build_dir=$1
test_log=$2
fn=$(realpath $test_log )
if [[ ! -d $build_dir ]]; then 
        build_dir=build
fi 
make -j {{ cpu_count }}   $build_dir/njs_unit_test > /dev/null   2>&1 
rm -fr defect4c_asan 
mkdir -p defect4c_asan 

if [ ! -f cve_2021_46462_poc.js ]; then 
 cp /src/projects/nginx___njs/cve_2021_46462_poc.js  ./cve_2021_46462_poc.js 
fi 
# Test CVE-2021-46461 POC
# Bounded: buggy njs may loop on SIGSEGV (ASAN DEADLYSIGNAL) and spew GBs.
ASAN_OPTIONS="halt_on_error=1:detect_leaks=0" timeout 120 $build_dir/njs cve_2021_46462_poc.js 2>&1 | head -c 4000000 >> $test_log
poc_rc=${PIPESTATUS[0]}
if [ $poc_rc -eq 124 ]; then echo "NJS_POC_TIMEOUT rc=124" >> $test_log; fi
if [ $poc_rc -gt 128 ] && [ $poc_rc -ne 141 ]; then echo "NJS_POC_SIGNAL rc=$poc_rc" >> $test_log; fi
if [ $poc_rc -eq 141 ]; then echo "NJS_POC_SIGPIPE rc=141" >> $test_log; fi

get_status() {
        string=$(cat $fn)
        if [[ $string == *"==ERROR"* ]] || [[ $string == *"AddressSanitizer"* ]] || [[ $string == *"SIGSEGV, Segmentation fault"* ]] || [[ $string == *"NJS_POC_TIMEOUT"* ]] || [[ $string == *"NJS_POC_SIGNAL"* ]] || [[ $string == *"NJS_POC_SIGPIPE"* ]] ; then        
            echo "FAILED"
        else
            echo "success"
        fi
}
get_err_msg() {
        # Check if AddressSanitizer error detected
        string=$(cat $test_log)
        if [[ $string == *"AddressSanitizer"* ]]; then
            echo "FAIL: AddressSanitizer detected - CVE-2021-46461 vulnerability reproduced" > $1
            cat $test_log >> $1
        else
            echo "PASS: No AddressSanitizer error - CVE-2021-46461 likely patched" > $1
            cat $test_log >> $1
        fi
}
fix_log="${test_log/\.log/}"
echo $fix_log"---->"
status_log=$( get_status)
echo $status_log > "${fix_log}.status"
get_err_msg "${fix_log}.msg"
