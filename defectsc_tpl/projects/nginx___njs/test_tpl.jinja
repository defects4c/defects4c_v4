# bash inplace_test.sh [op_name] [argv]
# bash  inplace_test.sh "get_status" this_is_test_log 

build_dir=$1
test_log=$2
fn=$(realpath $test_log )

if [[ ! -d $build_dir ]]; then 
	build_dir=build
	
fi 


# njs_unit_test must be linked with ASAN: libnjs.a objects are ASAN-instrumented
# (see build_tpl.jinja NJS_CFLAGS/NJS_LINK). Without -fsanitize=address on the link
# line the unit-test binary fails to link (undefined __asan_* refs) and the
# discriminating CVE test case never runs -> both fix and buggy wrongly "pass".
NJS_ASAN_CFLAGS="-pipe -fPIC -fvisibility=hidden -O -W -Wall -Wextra -Wno-unused-parameter -Wwrite-strings -Wmissing-prototypes -Werror -g -O -fsanitize=address -fno-omit-frame-pointer"
make -j {{ cpu_count }}   $build_dir/njs_unit_test   NJS_CFLAGS="$NJS_ASAN_CFLAGS"   NJS_LINK="gcc -fsanitize=address" > /dev/null   2>&1 


rm -fr defect4c_asan 
mkdir -p defect4c_asan 


{% for test_file in test_files %}

	{% if test_file.endswith(".c") %}
	
		# Bound the run: a buggy njs may infinite-recurse and spew GBs of ASAN output.
		# timeout->124 (treated as failure). Cap captured output to keep logs sane.
		# Pipe through head: caps disk usage AND sends SIGPIPE once 4MB seen, which stops
		# a buggy njs_unit_test that loops on SIGSEGV (ASAN DEADLYSIGNAL) instead of waiting
		# out the full timeout. timeout is the hard backstop for a genuine hang.
		ASAN_OPTIONS="halt_on_error=1:detect_leaks=0" timeout 600 $build_dir/njs_unit_test 2>&1 | head -c 4000000 >> $test_log
		ut_rc=${PIPESTATUS[0]}
		if [ $ut_rc -eq 124 ]; then echo "NJS_UNIT_TEST_TIMEOUT rc=124" >> $test_log; fi
		if [ $ut_rc -ne 0 ] && [ $ut_rc -ne 124 ] && [ $ut_rc -ne 141 ]; then echo "NJS_UNIT_TEST_NONZERO rc=$ut_rc" >> $test_log; fi
		if [ $ut_rc -eq 141 ]; then echo "NJS_UNIT_TEST_SIGPIPE rc=141" >> $test_log; fi
		
		 
		
	{% else %}
		# Bound the njs shell run: a buggy njs may loop on SIGSEGV (ASAN DEADLYSIGNAL)
		# and spew GBs. halt_on_error=1 + timeout keep it bounded; cap captured output.
		ASAN_OPTIONS="halt_on_error=1:detect_leaks=0" timeout 300 $build_dir/njs {{test_file}} 2>&1 | head -c 4000000 >> $test_log
		njs_rc=${PIPESTATUS[0]}
		if [ $njs_rc -eq 124 ]; then echo "NJS_SHELL_TIMEOUT rc=124" >> $test_log; fi
		if [ $njs_rc -gt 128 ] && [ $njs_rc -ne 141 ]; then echo "NJS_SHELL_SIGNAL rc=$njs_rc" >> $test_log; fi
		if [ $njs_rc -eq 141 ]; then echo "NJS_SHELL_SIGPIPE rc=141" >> $test_log; fi
	{% endif %}

{% endfor %}  





get_status() {
	string=$(cat $fn)
	
        if [[ $string == *"==ERROR"* ]] || [[ $string == *"AddressSanitizer:"* ]] || [[ $string == *"SIGSEGV, Segmentation fault"* ]] || [[ $string == *"TOTAL: FAILED"* ]] || [[ $string == *"NJS_UNIT_TEST_TIMEOUT"* ]] || [[ $string == *"NJS_UNIT_TEST_NONZERO"* ]] || [[ $string == *"NJS_SHELL_TIMEOUT"* ]] || [[ $string == *"NJS_SHELL_SIGNAL"* ]] || [[ $string == *"NJS_UNIT_TEST_SIGPIPE"* ]] || [[ $string == *"NJS_SHELL_SIGPIPE"* ]] ; then	    echo "FAILED\n"
	    
	else
	    echo "success\n"
	fi	
}

get_err_msg() {
	cat $test_log > $1 
#	string=$(awk "/AddressSanitizer/,0" $fn)
#	echo $string 
	
}


fix_log="${test_log/\.log/}"
echo $fix_log"---->"

status_log=$( get_status)
echo $status_log > "${fix_log}.status"
#msg_log=$( get_err_msg)
#echo $msg_log > "${fix_log}.msg"

get_err_msg "${fix_log}.msg"

