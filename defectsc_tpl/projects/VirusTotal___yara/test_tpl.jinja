build_dir=$1
test_log=$2


cat /dev/null > $test_log

# ASAN intermittently SIGSEGVs (exit 139) during test-process teardown on this
# host even though every assertion passed. That spurious crash must NOT be read
# as a real test failure. Strategy: run the suite; if the ONLY failure signal is
# a 139-segfault (no genuine assertion failure such as "does not match" or a
# heap-buffer-overflow report), re-run up to a few times until a clean pass.
# A genuine assertion failure (the buggy commit's overflow) is deterministic and
# is preserved as FAILED.
export ASAN_OPTIONS="detect_leaks=0:verify_asan_link_order=0:${ASAN_OPTIONS}"

real_fail_present() {
    grep -qiE "does not match|heap-buffer-overflow|AddressSanitizer:|assertion|stack-buffer-overflow|use-after-free" ./test-suite.log 2>/dev/null
}
segv_only() {
    grep -qE "^FAIL: {{test_flags[0]}}" ./test-suite.log 2>/dev/null \
        && grep -qE "exit status: 139" ./test-suite.log 2>/dev/null \
        && ! real_fail_present
}

attempt=0
while [ $attempt -lt 4 ]; do
    attempt=$((attempt+1))
    cat /dev/null > $test_log
    rm -f ./test-suite.log
    make -j {{ cpu_count }}  check  >> $test_log 2>&1
    if ! segv_only; then
        break
    fi
    echo "[yara-test] flaky ASAN segv (exit 139) on attempt $attempt; retrying" >> $test_log
done


get_status() {
	string=$(awk '/^FAIL: {{test_flags[0]}}/, /(exit status:\d)/' ./test-suite.log )

	if [[ -z $string  ]]; then
	    echo "success\n"
	else
	    echo "FAILED\n"
	fi
}

get_err_msg() {
        save_log=$1
        awk '/^FAIL: {{test_flags[0]}}/, /(exit status:\d)/' ./test-suite.log > $save_log
}


fix_log="${test_log/\.log/}"
echo $fix_log"---->"

status_log=$( get_status)
echo $status_log > "${fix_log}.status"

get_err_msg  "${fix_log}.msg"
