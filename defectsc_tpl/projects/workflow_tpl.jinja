export CXX=clang++
export CC=clang

# d4c-guard: cap single-file size so a looping buggy binary can't fill the disk
# (unit = 1024-byte blocks; 8388608 = 8 GiB). SIGXFSZ kills the writer past this.
ulimit -f 8388608 2>/dev/null || true


{%for env_item in env %}
	export {{env_item}}
{%endfor%}



cd {{repo_dir}}



git -C {{repo_dir}} checkout -f {{commit_after}}
git -C {{repo_dir}} checkout -f {{commit_after}} -- {{src_file}}


test_log_dirname=$(dirname  {{test_log}} )
mkdir -p $test_log_dirname


bash  inplace_build.sh {{build_dir}} {{test_log}} || { echo "Command 1 failed"; exit 1; }


setarch -R bash inplace_test.sh  {{build_dir}}  {{test_log}}




git -C {{repo_dir}} checkout -f {{commit_before}} -- {{src_file}}


bash  inplace_rebuild.sh {{build_dir}} {{test_log| replace("_fix.log", "_buggy.log") }} || { echo "Command 2 failed"; exit 1; }

setarch -R bash inplace_test.sh  {{build_dir}}   {{test_log| replace("_fix.log", "_buggy.log") }}



USERNAME="defects4c_user"
chown -R "$USERNAME:$USERNAME" ./ || true