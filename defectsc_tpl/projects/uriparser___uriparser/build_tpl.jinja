build_dir=$1
test_log=$2

fn=$(realpath $build_dir)


cur_dir=$(pwd)
## build_deps

{% if not is_rebuild %}

if [[ ! -d ../deps_dirs/automake_bin ]]; then 
        mkdir -p ../deps_dirs/
        cd ../deps_dirs/

        if ! wget --timeout=20 --tries=1 --show-progress \
                https://ftp.gnu.org/gnu/automake/automake-1.16.5.tar.gz; then
                if ! command -v gdown >/dev/null 2>&1; then
                        python3 -m pip install --no-cache-dir gdown
                fi

                gdown --fuzzy 'https://drive.google.com/file/d/1UXUBkJjlsEzI68oqn-rjGE8of_Wt1lYU/view?usp=drive_link' \
                        -O automake-1.16.5.tar.gz
        fi

        tar -xf automake-1.16.5.tar.gz
        cd automake-1.16.5

        echo "$(pwd)"

        ./configure --prefix="$(pwd)/../automake_bin"

        make -j {{cpu_count}}
        make install

        echo "the installation is done"
        cd "$cur_dir"

fi 
{% endif %}


export PATH=$cur_dir/../deps_dirs/automake_bin/bin/:$PATH
echo "the PATH is "$PATH
automake_version=$(automake --version)
echo "the version is "$automake_version


set -e 

{% if not is_rebuild %}

		
	 ( ./autogen.sh  )|| (
	 
	 libtoolize --force
	aclocal
	autoheader
	automake --force-missing --add-missing
	autoconf
	 
	 ) || ( echo "cannot inita" && exit 1 )
	
	
	CC="gcc -fsanitize=address" CXX="g++ -fsanitize=address" LDFLAGS="-fsanitize=address" ./configure   --prefix=$fn 

{% endif %}


set +e 

# CVE-2018-20721 (cef25028) reproduces only if the gtest TEST BINARY is itself
# AddressSanitizer-instrumented: the OOB read is on a buffer owned by test.cpp,
# so without redzones in the TEST object ASAN cannot see it. The checked-out slot
# ships STALE pre-compiled, NON-asan test objects whose mtime makes make consider
# them up-to-date, so it relinks an UNINSTRUMENTED test binary
# (nm uriparser_test | grep -c __asan == 0) and the buggy commit wrongly PASSES.
# For THIS bug only, purge the test objects so they recompile with
# CC/CXX="g{cc,++} -fsanitize=address" and the test binary is truly ASAN-linked.
# Scoped to the cef sha because other uriparser bugs use a different toolchain
# (e.g. 864f5d4c links the test with clang++ and would fail to resolve __asan_*
# symbols if forced to relink against the asan-instrumented library).
if [[ $test_log =~ "cef25028de5ff872c2e1f0a6c562eb3ea9ecbce4" ]]; then
	rm -f test/*.o test/.deps/*.Po 2>/dev/null || true
	rm -f test/uriparser_test test/.libs/uriparser_test 2>/dev/null || true
	make -j {{ cpu_count }} CC="gcc -fsanitize=address" CXX="g++ -fsanitize=address" LDFLAGS="-fsanitize=address"
else
	make -j {{ cpu_count }} LDFLAGS="-fsanitize=address"
fi
